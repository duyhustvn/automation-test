{
  "name": "e2e-tests",
  "version": "1.0.0",
  "description": "Playwright Automation Tests for Go REST API with MongoDB & Redis checks",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "test:bdd": "bddgen -c playwright.bdd.config.ts && playwright test -c playwright.bdd.config.ts",
    "test:bdd:ui": "bddgen -c playwright.bdd.config.ts && playwright test -c playwright.bdd.config.ts --ui",
    "report:bdd": "playwright show-report playwright-report-bdd"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.0.0",
    "ioredis": "^5.4.1",
    "mongodb": "^6.12.0",
    "playwright-bdd": "^8.2.0"
  }
}
